# =========================
# HAaaS public-safe example environment
# =========================

APP_ENV=development
APP_NAME=haaas-poc
LOG_LEVEL=INFO

# =========================
# Home Assistant instance
# =========================

HA_INSTANCE_NAME=local-ha-demo
HA_BASE_URL=http://localhost:8123
HA_CONFIG_DIR=./config
HA_DATA_DIR=./data/home-assistant

# Leave empty in public examples.
HA_LONG_LIVED_ACCESS_TOKEN=

# =========================
# Hosting / network model
# =========================

HOSTING_TARGET=local-docker
PUBLIC_ACCESS_MODE=none
TUNNEL_PROVIDER=

# =========================
# Database / telemetry placeholders
# =========================

DATABASE_TYPE=sqlite
TELEMETRY_BACKEND=none
METRICS_ENABLED=false

# =========================
# Lifecycle / validation
# =========================

VALIDATION_STRICT_MODE=false
SERVICE_STAGE=architecture-poc
COMPLIANCE_FRAMEWORKS=GDPR,ISO27001,NIST

# =========================
# Optional AI / documentation search placeholders
# =========================

AI_ASSIST_ENABLED=false
EMBEDDING_PROVIDER=none
VECTOR_DB_TYPE=none
